# Server
PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/leadboard
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/leadboard?appName=Cluster0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/leadboard

# Allowed frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# JWT secret for authentication (required in production)
JWT_SECRET=replace-with-a-long-random-string

# JWT expiry (optional, default 7d)
# JWT_EXPIRES_IN=7d

# Gemini API key for the AI assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Gemini model (optional, default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash