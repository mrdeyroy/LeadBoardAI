# Server
PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/leadboard
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/leadboard?appName=Cluster0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/leadboard

# Allowed frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Clerk authentication (https://dashboard.clerk.com -> API Keys)
# Secret key: sk_test_... / sk_live_...  — backend only, never expose
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
# Publishable key: pk_test_... / pk_live_... (frontend uses a copy of this)
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# Optional: PEM public key for networkless JWT verification.
# From Clerk Dashboard -> API Keys -> Show JWT public key -> PEM Public Key.
# Without it Clerk fetches its JWKS over the network on first request.
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...

# Gemini API key for the AI assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Gemini model (optional, default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash