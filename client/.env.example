# Clerk publishable key (https://dashboard.clerk.com -> API Keys)
# Frontend copy of the same value configured server-side.
VITE_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# API base URL used by the browser.
# In development requests go through the Vite proxy (/api -> http://localhost:5000),
# so this is only needed when calling the backend directly.
# VITE_API_URL=http://localhost:5000